{
  "name": "auto-fix-all-open",
  "displayName": "Auto Fix All Open",
  "description": "Behebt alle automatisch behebbaren Probleme (inkl. spezieller Markdown- und Python-Regeln) in allen geöffneten Dateien, speichert diese direkt ab und bietet eine Rückgängig-Funktion.",
  "version": "1.2.0",
  "repository": {
    "url": "https://www.github.com/TGBox/vs-code-problem-fixer"
  },
  "publisher": "DanielRoesch",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auto-fix-all.fixAllOpen",
        "title": "Alle Probleme in offenen Dateien beheben & speichern",
        "category": "Auto-Fix All",
        "icon": "$(sparkle)"
      },
      {
        "command": "auto-fix-all.removeUnnecessaryTypecasts",
        "title": "Unnötige Typecasts in offenen Dateien entfernen",
        "category": "Auto-Fix All",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "auto-fix-all.undoLastFix",
        "title": "Letzten Auto-Fix Durchlauf rückgängig machen",
        "category": "Auto-Fix All",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "auto-fix-all.fixAllOpen",
          "group": "navigation@1"
        },
        {
          "command": "auto-fix-all.undoLastFix",
          "group": "navigation@2",
          "when": "autoFixAll.canUndo"
        }
      ],
      "editor/context": [
        {
          "command": "auto-fix-all.fixAllOpen",
          "group": "navigation@1"
        },
        {
          "command": "auto-fix-all.undoLastFix",
          "group": "navigation@2",
          "when": "autoFixAll.canUndo"
        }
      ],
      "commandPalette": [
        {
          "command": "auto-fix-all.fixAllOpen"
        },
        {
          "command": "auto-fix-all.removeUnnecessaryTypecasts"
        },
        {
          "command": "auto-fix-all.undoLastFix",
          "when": "autoFixAll.canUndo"
        }
      ]
    },
    "configuration": {
      "title": "Auto Fix All Open",
      "properties": {
        "autoFixAll.python.fixIdentityComparisons": {
          "type": "boolean",
          "default": true,
          "description": "Python: Vom Analyzer gemeldete Identitätsvergleiche, die immer True/False ergeben (z.B. \"Identity comparison `False is True` is always False\"), automatisch umschreiben: `x is True` -> `x`, `x is False` -> `not x`."
        },
        "autoFixAll.python.splitAssertions": {
          "type": "boolean",
          "default": true,
          "description": "Python: Betroffene `assert a and b`-Zeilen in einzelne assert-Zeilen aufteilen, damit pytest bei Fehlschlägen den konkreten Teilausdruck anzeigt."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
