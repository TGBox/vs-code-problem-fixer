{
  "name": "auto-fix-all-open",
  "displayName": "Auto Fix All Open",
  "description": "Behebt alle automatisch behebbaren Probleme (inkl. unnötiger Typecasts und spezieller Markdown-Regeln) in allen geöffneten Dateien, speichert diese direkt ab und bietet eine Rückgängig-Funktion.",
  "version": "1.0.3",
  "publisher": "DanielRoesch",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "auto-fix-all.fixAllOpen",
        "title": "Alle Probleme in offenen Dateien beheben & speichern",
        "category": "Auto-Fix All",
        "icon": "$(sparkle)"
      },
      {
        "command": "auto-fix-all.removeUnnecessaryTypecasts",
        "title": "Unnötige Typecasts in offenen Dateien entfernen",
        "category": "Auto-Fix All",
        "icon": "$(symbol-operator)"
      },
      {
        "command": "auto-fix-all.undoLastFix",
        "title": "Letzten Auto-Fix Durchlauf rückgängig machen",
        "category": "Auto-Fix All",
        "icon": "$(discard)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "auto-fix-all.fixAllOpen",
          "group": "navigation@1"
        },
        {
          "command": "auto-fix-all.undoLastFix",
          "group": "navigation@2",
          "when": "autoFixAll.canUndo"
        }
      ],
      "editor/context": [
        {
          "command": "auto-fix-all.fixAllOpen",
          "group": "navigation@1"
        },
        {
          "command": "auto-fix-all.undoLastFix",
          "group": "navigation@2",
          "when": "autoFixAll.canUndo"
        }
      ],
      "commandPalette": [
        {
          "command": "auto-fix-all.fixAllOpen"
        },
        {
          "command": "auto-fix-all.removeUnnecessaryTypecasts"
        },
        {
          "command": "auto-fix-all.undoLastFix",
          "when": "autoFixAll.canUndo"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}